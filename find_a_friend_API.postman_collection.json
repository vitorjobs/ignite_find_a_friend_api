		{
			"name": "Pet",
			"item": [
				{
					"name": "Create Pet",
					"event": [
						{
							"listen": "prerequest",
							"script": {
								"exec": [
									"// Pré-script para gerar dados dinâmicos de animais",
									"pm.environment.set(\"animal_nome\", \"Mel\");",
									"pm.environment.set(\"animal_descricao\", \"Gata dócil e sociável\");",
									"pm.environment.set(\"animal_idade\", \"3\");",
									"pm.environment.set(\"animal_energia\", \"Média\");",
									"pm.environment.set(\"animal_porte\", \"Pequeno\");",
									"pm.environment.set(\"animal_cidade\", \"Belo Horizonte\");",
									"pm.environment.set(\"animal_requisitos\", \"Gosta de companhia\");",
									"",
									"// Gerar dados dinâmicos alternativos (exemplo de variação)",
									"const nomes = [\"Mel\", \"Luna\", \"Thor\", \"Bella\", \"Max\", \"Nina\"];",
									"const especies = [\"Gato\", \"Cachorro\", \"Coelho\", \"Pássaro\"];",
									"const descricoes = [",
									"    \"Animal dócil e carinhoso\",",
									"    \"Muito brincalhão e energético\", ",
									"    \"Calmo e tranquilo\",",
									"    \"Sociável e amigável\"",
									"];",
									"const cidades = [\"Belo Horizonte\", \"São Paulo\", \"Rio de Janeiro\", \"Curitiba\"];",
									"",
									"// Selecionar valores aleatórios",
									"const nomeAleatorio = nomes[Math.floor(Math.random() * nomes.length)];",
									"const especieAleatoria = especies[Math.floor(Math.random() * especies.length)];",
									"const descricaoAleatoria = descricoes[Math.floor(Math.random() * descricoes.length)];",
									"const cidadeAleatoria = cidades[Math.floor(Math.random() * cidades.length)];",
									"",
									"// Definir variáveis dinâmicas",
									"pm.environment.set(\"animal_nome_dinamico\", nomeAleatorio);",
									"pm.environment.set(\"animal_especie_dinamico\", especieAleatoria);",
									"pm.environment.set(\"animal_descricao_dinamico\", descricaoAleatoria);",
									"pm.environment.set(\"animal_idade_dinamico\", (Math.floor(Math.random() * 10) + 1).toString());",
									"pm.environment.set(\"animal_energia_dinamico\", [\"Baixa\", \"Média\", \"Alta\"][Math.floor(Math.random() * 3)]);",
									"pm.environment.set(\"animal_porte_dinamico\", [\"Pequeno\", \"Médio\", \"Grande\"][Math.floor(Math.random() * 3)]);",
									"pm.environment.set(\"animal_cidade_dinamico\", cidadeAleatoria);",
									"pm.environment.set(\"animal_requisitos_dinamico\", \"Necessita de atenção e carinho\");",
									"",
									"// Gerar o objeto JSON completo",
									"const animalData = {",
									"    \"nome\": pm.environment.get(\"animal_nome_dinamico\"),",
									"    \"descricao\": pm.environment.get(\"animal_descricao_dinamico\"),",
									"    \"idade\": pm.environment.get(\"animal_idade_dinamico\"),",
									"    \"energia\": pm.environment.get(\"animal_energia_dinamico\"),",
									"    \"porte\": pm.environment.get(\"animal_porte_dinamico\"),",
									"    \"cidade\": pm.environment.get(\"animal_cidade_dinamico\"),",
									"    \"requisitos\": pm.environment.get(\"animal_requisitos_dinamico\")",
									"};",
									"",
									"// Salvar o objeto completo como variável de ambiente",
									"pm.environment.set(\"animal_data_completo\", JSON.stringify(animalData));",
									"",
									"// Log para verificação",
									"console.log(\"Dados do animal gerados:\");",
									"console.log(JSON.stringify(animalData, null, 2));"
								],
								"type": "text/javascript",
								"packages": {}
							}
						}
					],
					"request": {
						"auth": {
							"type": "noauth"
						},
						"method": "POST",
						"header": [
							{
								"key": "Authorization",
