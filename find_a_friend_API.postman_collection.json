					"name": "Create Org",
					"event": [
						{
							"listen": "prerequest",
							"script": {
								"exec": [
									"// Pré-request Script",
									"function gerarCNPJ() {",
									"    function randomizar(n) {",
									"        return Math.floor(Math.random() * n);",
									"    }",
									"    ",
									"    function mod(dividendo, divisor) {",
									"        return Math.round(dividendo - (Math.floor(dividendo / divisor) * divisor));",
									"    }",
									"",
									"    const n = 9;",
									"    let n1 = randomizar(n);",
									"    let n2 = randomizar(n);",
									"    let n3 = randomizar(n);",
									"    let n4 = randomizar(n);",
									"    let n5 = randomizar(n);",
									"    let n6 = randomizar(n);",
									"    let n7 = randomizar(n);",
									"    let n8 = randomizar(n);",
									"    let n9 = 0; // 0001",
									"    let n10 = 0; // 0001",
									"    let n11 = 0; // 0001",
									"    let n12 = 1; // 0001",
									"",
									"    let d1 = n12 * 2 + n11 * 3 + n10 * 4 + n9 * 5 + n8 * 6 + n7 * 7 + n6 * 8 + n5 * 9 + n4 * 2 + n3 * 3 + n2 * 4 + n1 * 5;",
									"    d1 = 11 - (mod(d1, 11));",
									"    if (d1 >= 10) d1 = 0;",
									"",
									"    let d2 = d1 * 2 + n12 * 3 + n11 * 4 + n10 * 5 + n9 * 6 + n8 * 7 + n7 * 8 + n6 * 9 + n5 * 2 + n4 * 3 + n3 * 4 + n2 * 5 + n1 * 6;",
									"    d2 = 11 - (mod(d2, 11));",
									"    if (d2 >= 10) d2 = 0;",
									"",
									"    const cnpj = '' + n1 + n2 + n3 + n4 + n5 + n6 + n7 + n8 + n9 + n10 + n11 + n12 + d1 + d2;",
									"    ",
									"    // Formatar como CNPJ: XX.XXX.XXX/XXXX-XX",
									"    return cnpj.replace(/(\\d{2})(\\d{3})(\\d{3})(\\d{4})(\\d{2})/, \"$1.$2.$3/$4-$5\");",
									"}",
									"",
									"// Armazenar na variável de coleção",
									"pm.collectionVariables.set(\"randomCnpj\", gerarCNPJ());",
									"",
									"",
									"// *********************************************************",
									"",
									"// Pré-request Script - Telefone BR",
									"function gerarTelefoneBR() {",
									"    const ddd = ['11', '21', '31', '41', '51', '61', '71', '81', '91', '12', '22'];",
									"    const randomDDD = ddd[Math.floor(Math.random() * ddd.length)];",
									"    const numero = Math.floor(100000000 + Math.random() * 900000000).toString().substring(0, 8);",
									"    return `(${randomDDD}) 9${numero.substring(0, 4)}-${numero.substring(4)}`;",
									"}",
									"",
									"pm.collectionVariables.set(\"randomContact\", gerarTelefoneBR());",
									""
								],
								"type": "text/javascript",
								"packages": {}
							}
						}
					],
