generator client {
  provider = "prisma-client-js"
  // output   = "generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model org {
  id           Int           @id @default(autoincrement())
  nome         String        @db.VarChar(100)
  email        String        @unique @db.VarChar(100)
  org_contato  org_contato[]
  org_endereco org_endereco?
  pet          pet[]
}

model org_contato {
  id       Int    @id @default(autoincrement())
  org_id   Int
  whatsapp String @db.VarChar(20)
  org      org    @relation(fields: [org_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

model org_endereco {
  id     Int    @id @default(autoincrement())
  org_id Int    @unique
  cidade String @db.VarChar(100)
  org    org    @relation(fields: [org_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

model pet {
  id         Int     @id @default(autoincrement())
  nome       String  @db.VarChar(100)
  descricao  String?
  idade      String? @db.VarChar(20)
  energia    String? @db.VarChar(20)
  porte      String? @db.VarChar(20)
  requisitos String?
  cidade     String  @db.VarChar(100)
  org_id     Int
  org        org     @relation(fields: [org_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

model test {
  id   Int    @id @default(autoincrement())
  nome String
}
