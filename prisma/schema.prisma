//   cidade String

//   org    Org    @relation(fields: [org_id], references: [id])
//   org_id String
// }

model Pet {
  id         String  @id @default(uuid())
  nome       String
  descricao  String?
  idade      String?
  energia    String?
  porte      String?
  requisitos String?
  cidade     String
  org        Org     @relation(fields: [org_id], references: [id])
  org_id     String
}
