generator client {
  provider = "prisma-client-js"
  // output   = "generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Org {
  id       String @id @default(uuid())
  cnpj     String @unique
  nome     String
  email    String @unique
  contato  String
  endereco String
  // org_contato  Org_contato[]
  // org_endereco Org_endereco[]
  pet      Pet[]
}

