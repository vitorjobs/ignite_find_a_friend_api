{
  "name": "03_findafriendapi",
  "version": "1.0.0",
  "description": "Desafio Módulo 03 (SOLID) curso Ignite da RocketSeat",
  "main": "index.js",
  "type": "module",
  "scripts": {
    "start:dev": "tsx watch src/server.ts",
    "build": "tsup src --out-dir build",
    "start": "node build/server.cjs",
    "prisma:generate": "npx prisma generate",
    "prisma:pull": "npx prisma generate && npx prisma db pull",
    "prisma:migrate": "npx prisma migrate dev --create-only",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:unit": "vitest run --dir src/use-cases",
    "test:e2e": "vitest run --dir src/http/controllers",
    "test:coverage": "vitest run --coverage",
    "test:ci": "vitest run --coverage --reporter=dot",
    "test:ui": "vitest --ui",
    "sonar:ci": "export $(grep -v '^#' .env | xargs) && npx sonarqube-scanner -Dsonar.projectBaseDir=. -Dsonar.host.url=$SONARQUBE_URL -Dsonar.login=$SONARQUBE_TOKEN -Dsonar.projectKey=$SONARQUBE_PROJECT_KEY",
    "sonar": "npx sonarqube-scanner -Dsonar.projectBaseDir=.",
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs",
    "docs:production": "vitepress dev docs/.vitepress/dist"
  },
  "author": "Vìtor Guedes",
  "license": "MIT",
  "dependencies": {
    "@fastify/cookie": "11.0.2",
    "@fastify/jwt": "9.1.0",
    "@prisma/client": "^6.14.0",
    "bcryptjs": "3.0.2",
    "dayjs": "1.11.13",
    "dotenv": "16.4.7",
    "fastify": "^5.2.2",
    "fastify-metrics": "12.1.0",
    "pino": "^9.9.0",
    "pino-pretty": "^13.1.1",
    "prom-client": "15.1.3",
    "zod": "3.24.2"
  },
  "devDependencies": {
    "@eslint/js": "9.24.0",
    "@eslint/json": "0.11.0",
    "@eslint/markdown": "6.3.0",
    "@rocketseat/eslint-config": "2.2.2",
    "@types/node": "22.14.0",
    "@types/supertest": "6.0.3",
    "@vitest/coverage-v8": "^3.1.1",
    "eslint": "9.24.0",
    "globals": "16.0.0",
    "prisma": "^6.14.0",
    "sonarqube-scanner": "4.3.0",
    "supertest": "^7.1.1",
    "tsup": "8.4.0",
    "tsx": "4.19.3",
    "typescript": "5.8.3",
    "typescript-eslint": "8.29.1",
    "vite-tsconfig-paths": "5.1.4",
    "vitest": "^3.1.1",
    "@vitest/ui": "3.1.1",
    "vitepress": "^2.0.0-alpha.12"
  }
}